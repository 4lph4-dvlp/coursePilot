# ==============================================================================
# KAU LXP Assistant 설정 템플릿 (.env.example)
#
# 이 파일을 복사하여 `.env`로 저장한 뒤 값을 직접 채워 넣으세요.
# 완성된 `.env` 파일은 개인 비밀 정보(학번, 비밀번호, 토큰)를 포함하므로
# 절대 Git 커밋에 포함하거나 다른 사람과 공유하지 마세요.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LMS (학습 관리 시스템) 접속 정보
# ------------------------------------------------------------------------------
# 학교의 Coursemos(Moodle) 기반 LXP/LMS 주소입니다.
# - 한국항공대 학생은 기본값(https://lxp.kau.ac.kr)을 그대로 두거나 비워 두면 됩니다.
# - 이전 LMS(https://lms.kau.ac.kr)에는 지난 학기 과목만 보관되어 있으므로 현재 학기 과목이 나타나지 않습니다.
# - 타 대학 Coursemos(Moodle) 시스템인 경우 학교 LXP/LMS 주소로 변경하세요.
# - Canvas, Blackboard 등 다른 플랫폼은 지원하지 않습니다.
LMS_URL=https://lxp.kau.ac.kr

# LMS 로그인 학번/아이디
LMS_USERNAME=

# LMS 로그인 비밀번호
LMS_PASSWORD=

# ------------------------------------------------------------------------------
# 2. 브라우저 및 실행 옵션
# ------------------------------------------------------------------------------
# 백그라운드 헤드리스 모드 실행 여부 (true / false)
HEADLESS=true

# 페이지 로딩 및 셀렉터 대기 제한 시간 (밀리초, 기본 30000 = 30초)
TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 3. Notion Scheduler 동기화 설정 (선택 사항)
# ------------------------------------------------------------------------------
# Notion 통합(Internal Integration) Secret 토큰
NOTION_TOKEN=

# 동기화 대상 Notion 데이터베이스 ID (가장 확실한 식별자, 이름보다 우선 적용)
NOTION_DATABASE_ID=

# 동기화 대상 Notion 데이터베이스 이름 (기본값: Scheduler)
NOTION_DATABASE_NAME=

# 레거시 API 키 (NOTION_TOKEN이 없을 때만 대체용으로 사용됨)
# NOTION_API_KEY=
