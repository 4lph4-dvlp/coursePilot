# KAU LMS Configuration
LMS_URL=https://lms.kau.ac.kr
LMS_USERNAME=your_student_id
LMS_PASSWORD=your_password

# Notion Integration
# NOTION_TOKEN is preferred; NOTION_API_KEY remains supported for legacy setups.
NOTION_TOKEN=secret_your_notion_integration_token
# An explicit ID takes priority over exact-name discovery.
NOTION_DATABASE_ID=21d53280-64be-80ec-af4e-000b679f03bb
# Leave NOTION_DATABASE_ID empty to discover exactly one matching data source by name.
NOTION_DATABASE_NAME=Scheduler

# Browser & Execution Options
HEADLESS=true
TIMEOUT_MS=30000
